#!/usr/bin/env python3
"""voice-chat: 声で話しかけると、キャラクターが声で返事をする。

  voice-chat               1 回目で録音を始め、2 回目で止めて返事をする（キーに割り当てて使う）
                           返事の途中で押すと、読み上げを止めて録音を始める
  voice-chat --file x.wav  録音の代わりに音声ファイルで話しかける（16kHz モノラルの WAV）
  voice-chat --text 文章   声の代わりに文章で話しかける（試すとき用）
  voice-chat --reset       会話の履歴を消す

「ずんだもんに切り替えて」「めたんに代わって」のように名前を呼ぶと、話し相手が交代する。
キャラクターは characters.toml に書く。

声 → whisper-server（文字にする）→ llama-server（返事を考える）→ VOICEVOX（読み上げる）。
どれも自分のパソコンで動かすので、声も会話も外に出ない。
返事は少しずつ受け取り、1 文できるたびに読み上げを始めるので、全部できあがるのを待たない。

設定（環境変数）
  VOICE_CHAT_WHISPER_URL   whisper-server の /inference（既定 http://127.0.0.1:8082/inference）
  VOICE_CHAT_LLM_URL       llama-server の chat/completions（既定 http://127.0.0.1:8080/v1/chat/completions）
  VOICE_CHAT_LLM_MODEL     返事に使うモデル名（既定 gemma-4-E4B-it-qat）
  VOICE_CHAT_VOICEVOX_URL  VOICEVOX ENGINE（既定 http://127.0.0.1:50021）
  VOICE_CHAT_CHARACTERS    キャラクターの設定ファイル（既定 このスクリプトと同じ場所の characters.toml）
  VOICE_CHAT_TIMING        1 で、話し終えてから声が出るまでの時間を段階ごとに表示する
"""
import json
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import urllib.parse
import urllib.request
import uuid

WHISPER = os.environ.get("VOICE_CHAT_WHISPER_URL", "http://127.0.0.1:8082/inference")
LLM = os.environ.get("VOICE_CHAT_LLM_URL", "http://127.0.0.1:8080/v1/chat/completions")
MODEL = os.environ.get("VOICE_CHAT_LLM_MODEL", "gemma-4-E4B-it-qat")
VOICEVOX = os.environ.get("VOICE_CHAT_VOICEVOX_URL", "http://127.0.0.1:50021")
CHARACTERS = os.environ.get("VOICE_CHAT_CHARACTERS",
                            os.path.join(os.path.dirname(os.path.realpath(__file__)), "characters.toml"))
TIMING = os.environ.get("VOICE_CHAT_TIMING") == "1"

STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"voice-chat-{os.getuid()}")
AUDIO = os.path.join(STATE, "input.wav")
REC_PID = os.path.join(STATE, "recording.pid")
TALK_PID = os.path.join(STATE, "talking.pid")
HISTORY = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                       "voice-chat", "history.json")
KEEP_TURNS = 10  # 覚えておくやり取りの数（多いほど返事が遅くなる）

RULES = """
これは音声での会話です。返事は読み上げられるので、次のことを守ってください。
・1〜3 文の短い話し言葉で返す。
・箇条書き、見出し、記号、絵文字、URL は使わない。
・数字や英語は、読み上げやすい書き方にする。
"""

started = time.monotonic()


def say(msg):
    print(f"voice-chat: {msg}", file=sys.stderr)


def notify(msg):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "voice-chat", msg], stderr=subprocess.DEVNULL)


def lap(label):
    if TIMING:
        say(f"{time.monotonic() - started:5.2f}s  {label}")


def alive(pid_file):
    """pid ファイルのプロセスが動いていればその pid を返す。"""
    try:
        pid = int(open(pid_file).read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


# ---- 録音 ----

def start_recording():
    if os.path.exists(AUDIO):
        os.remove(AUDIO)
    # whisper は 16kHz・モノラルの音声を受け付ける
    rec = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", AUDIO],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    open(REC_PID, "w").write(str(rec.pid))
    notify("聞いています… もう一度押すと返事をします")


def stop_recording(pid):
    os.remove(REC_PID)
    os.kill(pid, signal.SIGINT)
    for _ in range(40):  # WAV が書き終わるのを待つ
        if not alive_pid(pid):
            break
        time.sleep(0.05)


def alive_pid(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


# ---- 文字にする ----

def transcribe(wav):
    boundary = uuid.uuid4().hex
    parts = [f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode()
             for k, v in (("language", "ja"), ("response_format", "text"), ("no_timestamps", "true"))]
    parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"in.wav\"\r\n"
                 "Content-Type: audio/wav\r\n\r\n".encode() + open(wav, "rb").read() + b"\r\n")
    req = urllib.request.Request(WHISPER, data=b"".join(parts) + f"--{boundary}--\r\n".encode(),
                                 headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    with urllib.request.urlopen(req, timeout=120) as res:
        text = " ".join(res.read().decode().split())
    # 声がないと Whisper は「(音楽)」「[拍手]」のような注記を書くことがある。これだけなら聞き取れなかった扱い
    return re.sub(r"[(（\[［【][^)）\]］】]*[)）\]］】]", "", text).strip()


# ---- キャラクターと履歴 ----

def load_characters():
    with open(CHARACTERS, "rb") as f:
        conf = tomllib.load(f)
    chars = {c["name"]: c for c in conf["character"]}
    return chars, conf.get("default", next(iter(chars)))


def load_history(default):
    try:
        return json.load(open(HISTORY))
    except (OSError, ValueError):
        return {"character": default, "messages": []}


def save_history(h):
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    h["messages"] = h["messages"][-KEEP_TURNS * 2:]
    with open(HISTORY, "w") as f:
        json.dump(h, f, ensure_ascii=False, indent=1)


def wants_switch(text, chars):
    """「〇〇に切り替えて」「〇〇に代わって」なら、そのキャラの名前を返す。"""
    if not re.search(r"(切り替え|切りかえ|変え|代わ|替わ|交代|呼んで)", text):
        return None
    for name, c in chars.items():
        if any(a in text for a in c["aliases"]):
            return name
    return None


# ---- 返事を考える（少しずつ受け取って 1 文ずつ渡す） ----

SENTENCE_END = re.compile(r"[。！？!?♪\n]")


def reply_sentences(messages):
    payload = {"model": MODEL, "stream": True, "temperature": 0.7, "max_tokens": 300,
               "chat_template_kwargs": {"enable_thinking": False}, "messages": messages}
    req = urllib.request.Request(LLM, data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    buf, first = "", True
    with urllib.request.urlopen(req, timeout=60) as res:
        for line in res:  # Server-Sent Events: 「data: {...}」が 1 行ずつ届く
            line = line.decode().strip()
            if not line.startswith("data: ") or line == "data: [DONE]":
                continue
            delta = json.loads(line[6:])["choices"][0]["delta"].get("content") or ""
            if first and delta:
                lap("返事の最初の文字")
                first = False
            buf += delta
            # 文の終わりが来たら、そこまでを 1 文として渡す
            while (m := SENTENCE_END.search(buf)):
                sentence, buf = buf[:m.end()].strip(), buf[m.end():]
                if sentence:
                    yield sentence
    if buf.strip():
        yield buf.strip()


def speakable(text):
    """読み上げに向かない記号を落とす。"""
    text = re.sub(r"[*#`_>|~]", "", text)
    return re.sub(r"[\U0001F000-\U0001FFFF☀-➿]", "", text).strip()


# ---- 読み上げる ----

def synthesize(text, c):
    q = urllib.parse.urlencode({"speaker": c["speaker"], "text": text})
    with urllib.request.urlopen(urllib.request.Request(f"{VOICEVOX}/audio_query?{q}", method="POST")) as res:
        query = json.load(res)
    query["speedScale"] = c.get("speed", 1.0)
    req = urllib.request.Request(f"{VOICEVOX}/synthesis?speaker={c['speaker']}", data=json.dumps(query).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req) as res:
        return res.read()


def speak(sentences, c, said=None):
    """文を受け取りながら声にし、前の文を再生している間に次の文を合成しておく。

    said を渡すと、実際に読み上げ始めた文をそこへ足していく（遮られたときに、どこまで話したか分かる）。
    """
    wavs = queue.Queue()

    def worker():
        try:
            for s in sentences:
                if (spoken := speakable(s)):
                    wavs.put((s, synthesize(spoken, c)))
        except Exception as e:  # noqa: BLE001 返事の途中で失敗しても、そこまでは話す
            say(f"返事の途中で失敗しました: {e}")
        finally:
            wavs.put(None)

    threading.Thread(target=worker, daemon=True).start()
    first = True
    while (item := wavs.get()) is not None:
        sentence, wav = item
        if first:
            lap("声が出始める")
            first = False
        if said is not None:
            said.append(sentence)
        with tempfile.NamedTemporaryFile(suffix=".wav", dir=STATE) as f:
            f.write(wav)
            f.flush()
            subprocess.run(["pw-play", f.name], stderr=subprocess.DEVNULL)


# ---- 会話 1 回分 ----

def talk(text):
    chars, default = load_characters()
    h = load_history(default)
    if h["character"] not in chars:
        h["character"] = default
    print(f"あなた: {text}")

    if (name := wants_switch(text, chars)):
        h["character"] = name
        c = chars[name]
        print(f"{name}: {c['greeting']}")
        speak(iter([c["greeting"]]), c)
        h["messages"] += [{"role": "user", "content": text}, {"role": "assistant", "content": f"（{name}に交代）{c['greeting']}"}]
        save_history(h)
        return

    c = chars[h["character"]]
    system = c["persona"].strip() + "\n" + RULES.strip()
    messages = [{"role": "system", "content": system}, *h["messages"], {"role": "user", "content": text}]
    said = []
    try:
        speak(reply_sentences(messages), c, said)
    finally:
        # 途中で遮られても、そこまで話した分は覚えておく
        answer = "".join(said)
        print(f"{c['name']}: {answer}")
        if answer:
            h["messages"] += [{"role": "user", "content": text}, {"role": "assistant", "content": answer}]
            save_history(h)


class Interrupted(Exception):
    """返事の途中でキーが押された。"""


def interrupted(*_):
    raise Interrupted


def main():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    args = sys.argv[1:]
    if args[:1] == ["--reset"]:
        if os.path.exists(HISTORY):
            os.remove(HISTORY)
        return
    if args[:1] == ["--text"]:
        return run(lambda: " ".join(args[1:]))
    if args[:1] == ["--file"]:
        return run(lambda: transcribe(args[1]))

    if (pid := alive(TALK_PID)):
        # 返事の途中で押されたら、読み上げを止めて聞く側に回る
        os.killpg(pid, signal.SIGTERM)
        start_recording()
    elif (pid := alive(REC_PID)):
        stop_recording(pid)
        lap("録音を止めた")
        run(lambda: transcribe(AUDIO))
    else:
        start_recording()


def run(get_text):
    """文字を受け取って返事をする。読み上げ中は自分を TALK_PID に書いておく。"""
    if os.getpgrp() != os.getpid():
        os.setpgrp()  # 再生中の pw-play ごとまとめて止められるよう、自分のグループを作る
    open(TALK_PID, "w").write(str(os.getpid()))
    signal.signal(signal.SIGTERM, interrupted)
    try:
        text = get_text()
        lap("文字になった")
        if not text:
            notify("声が聞き取れませんでした")
            return
        talk(text)
    except Interrupted:
        pass
    finally:
        if alive(TALK_PID) == os.getpid():
            os.remove(TALK_PID)


if __name__ == "__main__":
    main()
